[Unit]
Description=WaveSynAgent FastAPI agent server
After=network.target

[Service]
Type=simple
User=animnia
Group=animnia
WorkingDirectory=/home/animnia/wavesynagent/agent-server
EnvironmentFile=/home/animnia/wavesynagent/agent-server/.env
ExecStart=/home/animnia/wavesynagent/agent-server/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 3002
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15

# Log to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wavesyn-agent

[Install]
WantedBy=multi-user.target
