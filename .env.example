# ===== Database =====
DATABASE_URL=postgresql://postgres:password@localhost:5432/wavesynagent

# ===== JWT =====
JWT_SECRET=your-jwt-secret-here

# ===== LLM Providers =====
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里百炼 (DashScope)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== Server Ports =====
# agent-server reads HOST/PORT (pydantic-settings); must match the
# frontend vite proxy target (/agent-api -> http://localhost:3002).
HOST=0.0.0.0
PORT=3002
API_SERVER_PORT=3001

# Default LLM provider when the client doesn't specify one
DEFAULT_PROVIDER=deepseek
